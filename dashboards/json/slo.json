{
 "uid": "fincore-slo",
 "title": "FinCore / SLOs",
 "description": "Payments SLOs and their burn rates (gitops/platform/slo). Burn rate 1 = the budget lasts exactly 30 days; 14.4 over 1 h and 5 m, or 6 over 6 h and 30 m, pages.",
 "tags": [
  "fincore",
  "slo"
 ],
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "utc",
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Over the selected time range",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Availability (non-5xx)",
   "description": "Objective: 99.9 %.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - (sum(increase(http_requests_total{app=\"payments-api\",route=\"POST /v1/payments\",code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total{app=\"payments-api\",route=\"POST /v1/payments\"}[$__range]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Under 300 ms",
   "description": "Objective: 99 %.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(http_request_duration_seconds_bucket{app=\"payments-api\",route=\"POST /v1/payments\",le=\"0.3\"}[$__range])) / sum(increase(http_request_duration_seconds_count{app=\"payments-api\",route=\"POST /v1/payments\"}[$__range]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Availability burn rate (1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "fincore:payments_availability:error_ratio_rate1h / 0.001",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
