{
 "uid": "fincore-red",
 "title": "FinCore / Service RED",
 "description": "Rate, errors and duration per FinCore service and route, health probes excluded.",
 "tags": [
  "fincore",
  "red"
 ],
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "utc",
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(http_requests_total, app)",
     "refId": "service"
    },
    "definition": "label_values(http_requests_total, app)",
    "refresh": 2,
    "current": {
     "text": "payments-api",
     "value": "payments-api"
    },
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "$service",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Requests per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{app=\"$service\",route!~\"GET /(healthz|readyz)\"}[2m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "5xx ratio (5m)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(http_requests_total{app=\"$service\",route!~\"GET /(healthz|readyz)\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{app=\"$service\",route!~\"GET /(healthz|readyz)\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.001
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "p99 latency (5m)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"$service\",route!~\"GET /(healthz|readyz)\"}[5m])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Versions running",
   "description": "2 during a canary.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(count by (version) (fincore_build_info{app=\"$service\"}))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "timeseries",
   "title": "Rate by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(http_requests_total{app=\"$service\",route!~\"GET /(healthz|readyz)\"}[1m]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "id": 6,
