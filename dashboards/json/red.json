  {
   "type": "logs",
   "title": "Errors and warnings",
   "description": "From Loki. Open a line to jump to its trace.",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{app=\"$service\"} | json | level=~\"ERROR|WARN\"",
     "datasource": {
