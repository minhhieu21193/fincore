{
 "uid": "fincore-business",
 "title": "FinCore / Business",
 "description": "Payments as the business sees them: volume, outcomes, money moved, and the ledger's invariant.",
 "tags": [
  "fincore",
  "business"
 ],
 "editable": false,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "utc",
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Payments per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(payments_total[2m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Capture rate (5m)",
   "description": "Captured / all payments. Declines are a business outcome, not an error.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(payments_total{status=\"captured\"}[5m])) / sum(rate(payments_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Captured volume (USD/min)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(payments_amount_minor_units_total{currency=\"USD\"}[2m])) * 60 / 100",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Ledger imbalance",
   "description": "Sum of all debits minus credits, checked live by the ledger. Anything but 0 is a P1.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(abs(ledger_imbalance_minor_units)) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
