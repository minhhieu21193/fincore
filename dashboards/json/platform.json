   "title": "Log shipping (Fluent Bit)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(fluentbit_output_proc_records_total[1m]))",
