  {
   "type": "timeseries",
   "title": "Database credential changes (Vault-issued users)",
   "description": "Each step is a ledger pod switching to a fresh short-lived PostgreSQL user.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (increase(fincore_db_credential_changes_total[5m]))",
     "legendFormat": "{{pod}}",
